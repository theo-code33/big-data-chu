# Copier vers .env et adapter. Ne jamais committer .env.

# Sel de pseudonymisation (changez-le ; rester stable ensuite)
EDS_PSEUDO_SALT=chu-eds-dev-salt-changez-moi

# Chemin du filestorage CHU (lecture seule)
SOURCE_FILESTORAGE=../source-filestorage
LAKE_ROOT=./lake

# ClickHouse (côté hôte)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=eds_admin
CLICKHOUSE_PASSWORD=eds_admin

# Comptes cloisonnés (créés au démarrage)
CLICKHOUSE_PILOTAGE_USER=pilotage
CLICKHOUSE_PILOTAGE_PASSWORD=pilotage
CLICKHOUSE_RECHERCHE_USER=recherche
CLICKHOUSE_RECHERCHE_PASSWORD=recherche

# Metabase (host = nom du service Compose, vu depuis le conteneur Metabase)
METABASE_CLICKHOUSE_HOST=clickhouse
METABASE_URL=http://localhost:3000
METABASE_ADMIN_EMAIL=admin@chu.local
METABASE_ADMIN_PASSWORD=AdminEDS123!
METABASE_PILOTAGE_EMAIL=pilotage@chu.local
METABASE_PILOTAGE_PASSWORD=Pilotage123!
METABASE_RECHERCHE_EMAIL=recherche@chu.local
METABASE_RECHERCHE_PASSWORD=Recherche123!
